# ============================================================
#  CRYTEAM SecWeb — пример конфигурации окружения
#  Скопируйте этот файл в `.env` и подставьте собственные значения.
# ============================================================

# --- База данных (СТРОГО SQLite) ---
# Файл базы данных Prisma. Не меняйте провайдер — поддерживается только SQLite.
DATABASE_URL="file:./dev.db"

# --- Секреты JWT ---
# Сгенерируйте длинные случайные строки, например:  openssl rand -base64 48
# ACCESS-токен живёт недолго, REFRESH-токен — дольше.
JWT_ACCESS_SECRET="замените_на_длинный_случайный_секрет_доступа"
JWT_REFRESH_SECRET="замените_на_длинный_случайный_секрет_обновления"

# Время жизни токенов (в секундах).
JWT_ACCESS_TTL="900"          # 15 минут
JWT_REFRESH_TTL="1209600"     # 14 дней

# --- Скрытый (хешированный) маршрут админ-панели ---
# Доступ к админке возможен ТОЛЬКО по этому секретному сегменту:
#   /panel/<ADMIN_HASH_ROUTE>
# Сгенерируйте, например:  openssl rand -hex 24
ADMIN_HASH_ROUTE="admin-gateway-6f4c2a9b8e1d7c3a5b0f9e2d"

# --- Учётная запись администратора по умолчанию (используется в seed) ---
ADMIN_EMAIL="admin@cryteam.local"
ADMIN_PASSWORD="Admin#SecWeb2026"
ADMIN_NAME="Главный администратор"

# --- Настройки безопасности ---
# Разрешённые источники для CORS (через запятую). Пусто = только тот же origin.
CORS_ALLOWED_ORIGINS=""

# Режим окружения (development | production).
NODE_ENV="development"
